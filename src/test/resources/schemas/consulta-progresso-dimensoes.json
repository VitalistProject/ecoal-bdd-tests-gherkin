{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["dimensions"],
  "properties": {
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "completed",
          "total",
          "percentage"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "completed": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "percentage": {
            "type": "number"
          }
        }
      }
    }
  }
}